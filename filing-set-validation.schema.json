{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-docx.dev/schemas/filing-set-validation-v1.json",
  "title": "agent-docx filing set validation version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "documents", "pageCap", "status"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/documentId" },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/document" }
    },
    "pageCap": { "anyOf": [{ "$ref": "#/$defs/pageCap" }, { "type": "null" }] },
    "status": { "enum": ["pass", "fail", "unknown"] }
  },
  "$defs": {
    "documentId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "revisionId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "head", "validation", "pageCount"],
      "properties": {
        "documentId": { "$ref": "#/$defs/documentId" },
        "head": {
          "anyOf": [{ "$ref": "#/$defs/revisionId" }, { "type": "null" }]
        },
        "validation": {
          "anyOf": [{ "$ref": "#/$defs/validationResult" }, { "type": "null" }]
        },
        "pageCount": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        }
      }
    },
    "pageCap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit", "totalPages", "status", "detail"],
      "properties": {
        "limit": { "type": "integer", "minimum": 1 },
        "totalPages": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["pass", "fail", "unknown"] },
        "detail": { "type": "string" }
      }
    },
    "validationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "documentId",
        "revision",
        "rulePack",
        "scope",
        "status",
        "summary",
        "findings"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "documentId": { "$ref": "#/$defs/documentId" },
        "revision": {
          "anyOf": [{ "$ref": "#/$defs/revisionId" }, { "type": "null" }]
        },
        "rulePack": {
          "anyOf": [
            { "type": "string", "pattern": "^[a-z0-9][a-z0-9@.-]{0,127}$" },
            { "type": "null" }
          ]
        },
        "scope": { "$ref": "#/$defs/scope" },
        "status": { "enum": ["pass", "fail", "unknown"] },
        "summary": { "$ref": "#/$defs/summary" },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/point" },
        "end": { "$ref": "#/$defs/point" }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "column", "offset"],
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "offset": { "type": "integer", "minimum": 0 }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certification",
        "checkedRuleIds",
        "sourceSnapshots",
        "unmodeledProvisions"
      ],
      "properties": {
        "certification": { "const": false },
        "checkedRuleIds": { "type": "array", "items": { "type": "string" } },
        "sourceSnapshots": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceSnapshot" }
        },
        "unmodeledProvisions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceUrl", "effectiveDate", "sha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9@.-]{0,127}$" },
        "sourceUrl": { "type": "string", "format": "uri" },
        "effectiveDate": { "type": "string", "format": "date" },
        "sha256": { "$ref": "#/$defs/revisionId" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "fail", "unknown"],
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 }
      }
    },
    "json": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/json" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/json" } }
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkId",
        "status",
        "severity",
        "source",
        "message",
        "evidence"
      ],
      "properties": {
        "checkId": { "type": "string" },
        "status": { "enum": ["pass", "fail", "unknown"] },
        "severity": { "enum": ["info", "warning", "error"] },
        "source": { "enum": ["rule", "package", "template"] },
        "message": { "type": "string" },
        "citation": { "type": "string" },
        "sourceUrl": { "type": "string", "format": "uri" },
        "effectiveDate": { "type": "string", "format": "date" },
        "positions": {
          "type": "array",
          "items": { "$ref": "#/$defs/position" }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/json" }
        },
        "remediation": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/json" }
        }
      }
    }
  }
}
