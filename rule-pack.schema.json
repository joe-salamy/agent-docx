{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-docx.dev/schemas/rule-pack-v1.json",
  "title": "agent-docx immutable rule pack version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "sourceUrl", "effectiveDate", "sourceSha256", "sourceExcerpt", "checks", "unmodeledProvisions"],
  "properties": {
    "id": { "enum": ["frap-32@2024-12-01", "cand-civil@2026-05-01"] },
    "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "effectiveDate": { "type": "string", "format": "date" },
    "sourceSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sourceExcerpt": { "type": "string", "pattern": "^[a-z0-9-]+\\.txt$" },
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "citation", "predicate"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
          "kind": { "enum": ["length-alternative", "page-size", "margin-minimum", "typeface", "line-spacing", "counted-lines-maximum", "required-metadata", "required-block", "required-footer", "reference-integrity"] },
          "citation": { "type": "string", "minLength": 1 },
          "predicate": { "type": "string", "minLength": 1 }
        }
      }
    },
    "unmodeledProvisions": { "type": "array", "items": { "type": "string" } }
  }
}
