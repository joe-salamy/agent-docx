{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-docx.dev/schemas/rule-pack-v1.json",
  "title": "agent-docx rule pack version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "sourceUrl", "effectiveDate", "sourceSha256", "sourceExcerpt", "checks", "unmodeledProvisions"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9@.-]{0,127}$" },
    "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "effectiveDate": { "type": "string", "format": "date" },
    "sourceSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sourceExcerpt": { "type": "string", "pattern": "^[a-z0-9-]+\\.txt$" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "citation", "predicate"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
          "kind": { "enum": ["length-alternative", "page-size", "margin-minimum", "typeface", "line-spacing", "counted-lines-maximum", "required-metadata", "required-block", "required-footer", "reference-integrity"] },
          "citation": { "type": "string", "minLength": 1 },
          "predicate": { "type": "string", "minLength": 1 },
          "params": { "type": "object" }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "length-alternative" } } },
            "then": { "properties": { "params": { "$ref": "#/$defs/length-alternative" } } }
          },
          {
            "if": { "properties": { "kind": { "const": "page-size" } } },
            "then": { "properties": { "params": { "$ref": "#/$defs/page-size" } } }
          },
          {
            "if": { "properties": { "kind": { "const": "margin-minimum" } } },
            "then": { "properties": { "params": { "$ref": "#/$defs/margin-minimum" } } }
          },
          {
            "if": { "properties": { "kind": { "const": "typeface" } } },
            "then": { "properties": { "params": { "$ref": "#/$defs/typeface" } } }
          },
          {
            "if": { "properties": { "kind": { "const": "line-spacing" } } },
            "then": { "properties": { "params": { "$ref": "#/$defs/line-spacing" } } }
          },
          {
            "if": { "properties": { "kind": { "const": "counted-lines-maximum" } } },
            "then": { "properties": { "params": { "$ref": "#/$defs/counted-lines-maximum" } } }
          },
          {
            "if": { "properties": { "kind": { "const": "required-metadata" } } },
            "then": { "properties": { "params": { "$ref": "#/$defs/required-metadata" } } }
          },
          {
            "if": { "properties": { "kind": { "const": "required-block" } } },
            "then": { "properties": { "params": { "$ref": "#/$defs/required-block" } } }
          },
          {
            "if": { "properties": { "kind": { "const": "required-footer" } } },
            "then": { "properties": { "params": { "$ref": "#/$defs/required-footer" } } }
          },
          {
            "if": { "properties": { "kind": { "const": "reference-integrity" } } },
            "then": { "properties": { "params": { "$ref": "#/$defs/reference-integrity" } } }
          }
        ]
      }
    },
    "unmodeledProvisions": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "length-alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byFilingKind"],
      "properties": {
        "byFilingKind": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "default": { "$ref": "#/$defs/length-limit" },
            "principal-brief": { "$ref": "#/$defs/length-limit" },
            "reply-brief": { "$ref": "#/$defs/length-limit" },
            "motion-document": { "$ref": "#/$defs/length-limit" },
            "opposition-text": { "$ref": "#/$defs/length-limit" },
            "reply-text": { "$ref": "#/$defs/length-limit" }
          }
        }
      }
    },
    "length-limit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pages": { "type": "integer", "minimum": 1 },
        "words": { "type": "integer", "minimum": 1 },
        "monospacedLines": { "type": "integer", "minimum": 1 },
        "complianceCertificateRequired": { "type": "boolean" }
      }
    },
    "page-size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widthTwips", "heightTwips"],
      "properties": {
        "widthTwips": { "type": "integer", "minimum": 1 },
        "heightTwips": { "type": "integer", "minimum": 1 }
      }
    },
    "margin-minimum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumTwips"],
      "properties": { "minimumTwips": { "type": "integer", "minimum": 0 } }
    },
    "typeface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumTwips", "mode"],
      "properties": {
        "minimumTwips": { "type": "integer", "minimum": 0 },
        "mode": { "enum": ["proportional", "monospaced"] },
        "requireVerifiedPitch": { "type": "boolean" }
      }
    },
    "line-spacing": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "doubleSpacedOrdinary": { "type": "boolean" } }
    },
    "counted-lines-maximum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["perPageMaximum"],
      "properties": { "perPageMaximum": { "type": "integer", "minimum": 1 } }
    },
    "required-metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "requireCounselComplete": { "type": "boolean" },
        "requireComplianceCertificate": { "type": "boolean" }
      }
    },
    "required-block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kinds"],
      "properties": { "kinds": { "type": "array", "items": { "type": "string", "minLength": 1 } } }
    },
    "required-footer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredTokens"],
      "properties": { "requiredTokens": { "type": "array", "items": { "type": "string", "minLength": 1 } } }
    },
    "reference-integrity": {
      "type": "object",
      "additionalProperties": false
    }
  }
}
