{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-page-count.dev/schemas/cli-request-v1.json",
  "title": "md-page-count JSONL request version 1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["markdown"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "markdown": { "type": "string" }
      }
    }
  ],
  "$defs": {
    "id": { "type": ["string", "number", "null"] }
  }
}
