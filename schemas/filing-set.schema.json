{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-docx.dev/schemas/filing-set-v1.json",
  "title": "agent-docx filing set snapshot version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "label",
    "documentIds",
    "pageCap",
    "documents"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/documentId" },
    "label": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "documentIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/documentId" }
    },
    "pageCap": {
      "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/document" }
    }
  },
  "$defs": {
    "documentId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "revisionId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "head", "workingTreeHash", "matchesHead"],
      "properties": {
        "documentId": { "$ref": "#/$defs/documentId" },
        "head": {
          "anyOf": [{ "$ref": "#/$defs/revisionId" }, { "type": "null" }]
        },
        "workingTreeHash": { "$ref": "#/$defs/revisionId" },
        "matchesHead": { "type": "boolean" }
      }
    }
  }
}
