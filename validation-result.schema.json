{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-docx.dev/schemas/validation-result-v1.json",
  "title": "agent-docx validation result version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentId",
    "revision",
    "rulePack",
    "scope",
    "status",
    "summary",
    "findings"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "documentId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "revision": {
      "anyOf": [{ "$ref": "#/$defs/revisionId" }, { "type": "null" }]
    },
    "rulePack": {
      "anyOf": [
        { "type": "string", "pattern": "^[a-z0-9][a-z0-9@.-]{0,127}$" },
        { "type": "null" }
      ]
    },
    "scope": { "$ref": "#/$defs/scope" },
    "status": { "enum": ["pass", "fail", "unknown"] },
    "summary": { "$ref": "#/$defs/summary" },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
  },
  "$defs": {
    "revisionId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/point" },
        "end": { "$ref": "#/$defs/point" }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "column", "offset"],
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "offset": { "type": "integer", "minimum": 0 }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certification",
        "checkedRuleIds",
        "sourceSnapshots",
        "unmodeledProvisions"
      ],
      "properties": {
        "certification": { "const": false },
        "checkedRuleIds": { "type": "array", "items": { "type": "string" } },
        "sourceSnapshots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "sourceUrl", "effectiveDate", "sha256"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9@.-]{0,127}$"
              },
              "sourceUrl": { "type": "string", "format": "uri" },
              "effectiveDate": { "type": "string", "format": "date" },
              "sha256": { "$ref": "#/$defs/revisionId" }
            }
          }
        },
        "unmodeledProvisions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "fail", "unknown"],
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 }
      }
    },
    "json": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/json" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/json" } }
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkId",
        "status",
        "severity",
        "source",
        "message",
        "evidence"
      ],
      "properties": {
        "checkId": { "type": "string" },
        "status": { "enum": ["pass", "fail", "unknown"] },
        "severity": { "enum": ["info", "warning", "error"] },
        "source": { "enum": ["rule", "package", "template"] },
        "message": { "type": "string" },
        "citation": { "type": "string" },
        "sourceUrl": { "type": "string", "format": "uri" },
        "effectiveDate": { "type": "string", "format": "date" },
        "positions": {
          "type": "array",
          "items": { "$ref": "#/$defs/position" }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/json" }
        },
        "remediation": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/json" }
        }
      }
    }
  }
}
