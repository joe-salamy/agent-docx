{
  "name": "agent-docx",
  "version": "0.1.0",
  "description": "Agent-first legal Markdown-to-DOCX compiler with deterministic page and line constraints, native redlines, embedded revisions, and optional Word validation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joe-salamy/agent-docx.git"
  },
  "bugs": {
    "url": "https://github.com/joe-salamy/agent-docx/issues"
  },
  "homepage": "https://www.npmjs.com/package/agent-docx",
  "keywords": [
    "legal-tech",
    "legal-drafting",
    "markdown",
    "docx",
    "wordprocessingml",
    "redline",
    "tracked-changes",
    "pagination",
    "ai-agents",
    "typescript",
    "microsoft-word",
    "libreoffice"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.15.1",
  "bin": {
    "agent-docx": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config.schema.json": "./schemas/config.schema.json",
    "./measurement-request.schema.json": "./schemas/measurement-request.schema.json",
    "./measurement-result.schema.json": "./schemas/measurement-result.schema.json",
    "./docx-template-inspection.schema.json": "./schemas/docx-template-inspection.schema.json",
    "./measurement-stream.schema.json": "./schemas/measurement-stream.schema.json",
    "./cli-error.schema.json": "./schemas/cli-error.schema.json",
    "./profile-catalog.schema.json": "./schemas/profile-catalog.schema.json",
    "./project.schema.json": "./schemas/project.schema.json",
    "./rule-pack.schema.json": "./schemas/rule-pack.schema.json",
    "./agent-request.schema.json": "./schemas/agent-request.schema.json",
    "./agent-response.schema.json": "./schemas/agent-response.schema.json",
    "./agent-stream.schema.json": "./schemas/agent-stream.schema.json",
    "./revision.schema.json": "./schemas/revision.schema.json",
    "./change-set.schema.json": "./schemas/change-set.schema.json",
    "./source-patch.schema.json": "./schemas/source-patch.schema.json",
    "./validation-result.schema.json": "./schemas/validation-result.schema.json",
    "./artifact-result.schema.json": "./schemas/artifact-result.schema.json",
    "./compiled-docx.schema.json": "./schemas/compiled-docx.schema.json",
    "./docx-import-result.schema.json": "./schemas/docx-import-result.schema.json",
    "./redline-import-result.schema.json": "./schemas/redline-import-result.schema.json",
    "./filing-set.schema.json": "./schemas/filing-set.schema.json",
    "./filing-set-validation.schema.json": "./schemas/filing-set-validation.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "schemas",
    "skills",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -p tsconfig.json && node scripts/build.mjs",
    "build:tsc": "pnpm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run build && node --test",
    "prepack": "pnpm run build",
    "verify:pack": "node scripts/verify-pack.mjs",
    "accuracy": "node scripts/accuracy.mjs",
    "social:preview": "node scripts/social-preview.mjs",
    "smoke:agent": "pnpm run build && node scripts/smoke-agent-workflow.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "canonicalize": "^3.0.0",
    "chokidar": "^5.0.0",
    "docx": "^9.7.1",
    "fontkit": "^2.0.4",
    "linebreak": "^1.1.0",
    "pdf-lib": "1.17.1",
    "proper-lockfile": "^4.1.2",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "saxes": "^6.0.0",
    "unified": "^11.0.5",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/fontkit": "^2.0.8",
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/yauzl": "3.4.0",
    "esbuild": "^0.25.0",
    "prettier": "3.6.2",
    "typescript": "7.0.2"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "author": ""
}
