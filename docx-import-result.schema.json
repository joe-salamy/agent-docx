{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-docx.dev/schemas/docx-import-result-v1.json",
  "title": "agent-docx DOCX import result version 1",
  "oneOf": [{ "$ref": "#/$defs/inspect" }, { "$ref": "#/$defs/clean" }, { "$ref": "#/$defs/tracked" }],
  "$defs": {
    "sha": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "point": { "type": "object", "additionalProperties": false, "required": ["line", "column", "offset"], "properties": { "line": { "type": "integer", "minimum": 1 }, "column": { "type": "integer", "minimum": 1 }, "offset": { "type": "integer", "minimum": 0 } } },
    "position": { "type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": { "start": { "$ref": "#/$defs/point" }, "end": { "$ref": "#/$defs/point" } } },
    "item": { "type": "object", "additionalProperties": false, "required": ["status", "partPath", "relationshipId", "ooxmlKind", "count", "blockIds", "sourcePositions", "explanation"], "properties": { "status": { "enum": ["preserved", "normalized", "externalized", "unsupported"] }, "partPath": { "type": "string" }, "relationshipId": { "anyOf": [{ "type": "string" }, { "type": "null" }] }, "ooxmlKind": { "type": "string" }, "count": { "type": "integer", "minimum": 0 }, "blockIds": { "type": "array", "items": { "type": "string", "pattern": "^b_[0-9a-f-]{36}$" } }, "sourcePositions": { "type": "array", "items": { "$ref": "#/$defs/position" } }, "explanation": { "type": "string" } } },
    "recognized": { "type": "object", "additionalProperties": false, "required": ["blocks", "footnotes", "annotations", "assets"], "properties": { "blocks": { "type": "array", "items": { "type": "object" } }, "footnotes": { "type": "array", "items": { "type": "object" } }, "annotations": { "type": "array", "items": { "type": "object" } }, "assets": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": false, "required": ["sha256", "mediaType", "bytes"], "properties": { "sha256": { "$ref": "#/$defs/sha" }, "mediaType": { "type": "string" }, "bytes": { "type": "integer", "minimum": 0 } } } } } },
    "base": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "inspectOnly", "mode", "output", "sourceSha256", "baseRevision", "headRevision", "revisions", "recognized", "fidelity"], "properties": { "schemaVersion": { "const": 1 }, "inspectOnly": { "type": "boolean" }, "mode": {}, "output": {}, "sourceSha256": {}, "baseRevision": {}, "headRevision": {}, "revisions": {}, "recognized": { "$ref": "#/$defs/recognized" }, "fidelity": { "type": "object", "additionalProperties": false, "required": ["overall", "items"], "properties": { "overall": { "enum": ["preserved", "normalized", "unsupported"] }, "items": { "type": "array", "items": { "$ref": "#/$defs/item" } } } } } },
    "inspect": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "properties": { "inspectOnly": { "const": true }, "mode": { "const": "inspect" }, "output": { "type": "null" }, "sourceSha256": { "anyOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] }, "baseRevision": { "type": "null" }, "headRevision": { "type": "null" }, "revisions": { "type": "array", "maxItems": 0 } } }] },
    "clean": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "properties": { "inspectOnly": { "const": false }, "mode": { "const": "clean" }, "output": { "type": "string" }, "sourceSha256": { "$ref": "#/$defs/sha" }, "baseRevision": { "$ref": "#/$defs/sha" }, "headRevision": { "$ref": "#/$defs/sha" }, "revisions": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/sha" } } } }] },
    "tracked": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "properties": { "inspectOnly": { "const": false }, "mode": { "const": "tracked" }, "output": { "type": "string" }, "sourceSha256": { "$ref": "#/$defs/sha" }, "baseRevision": { "$ref": "#/$defs/sha" }, "headRevision": { "$ref": "#/$defs/sha" }, "revisions": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/sha" } } } }] }
  }
}
