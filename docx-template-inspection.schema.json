{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-docx.dev/schemas/docx-template-inspection-v1.json",
  "title": "agent-docx DOCX template inspection version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "imported",
    "sections",
    "selectedSection",
    "styles",
    "numbering",
    "headerFooters",
    "fields",
    "captions",
    "fonts",
    "unsupportedParts",
    "package",
    "warnings"
  ],
  "properties": {
    "imported": { "type": "object" },
    "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } },
    "selectedSection": { "type": "integer", "minimum": 0 },
    "styles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body",
        "headings",
        "quote",
        "list",
        "footnote",
        "footnoteReference"
      ],
      "properties": {
        "body": { "$ref": "#/$defs/style" },
        "headings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["1", "2", "3", "4", "5", "6"],
          "properties": {
            "1": { "$ref": "#/$defs/style" },
            "2": { "$ref": "#/$defs/style" },
            "3": { "$ref": "#/$defs/style" },
            "4": { "$ref": "#/$defs/style" },
            "5": { "$ref": "#/$defs/style" },
            "6": { "$ref": "#/$defs/style" }
          }
        },
        "quote": { "$ref": "#/$defs/style" },
        "list": { "$ref": "#/$defs/style" },
        "footnote": { "$ref": "#/$defs/style" },
        "footnoteReference": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/style" }]
        }
      }
    },
    "numbering": { "$ref": "#/$defs/numbering" },
    "headerFooters": {
      "type": "array",
      "items": { "$ref": "#/$defs/headerFooter" }
    },
    "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
    "captions": { "type": "array", "items": { "$ref": "#/$defs/caption" } },
    "fonts": { "$ref": "#/$defs/fonts" },
    "unsupportedParts": {
      "type": "array",
      "items": { "$ref": "#/$defs/unsupportedPart" }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "mainPart", "macroEnabled"],
      "properties": {
        "sha256": { "type": "string" },
        "mainPart": { "type": "string" },
        "macroEnabled": { "type": "boolean" }
      }
    },
    "warnings": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "column", "offset"],
      "properties": {
        "line": { "type": "integer" },
        "column": { "type": "integer" },
        "offset": { "type": "integer" }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "widthTwips",
        "heightTwips",
        "marginsTwips",
        "headerTwips",
        "footerTwips",
        "gutterTwips"
      ],
      "properties": {
        "widthTwips": { "type": "number" },
        "heightTwips": { "type": "number" },
        "marginsTwips": {
          "type": "object",
          "additionalProperties": false,
          "required": ["top", "right", "bottom", "left"],
          "properties": {
            "top": { "type": "number" },
            "right": { "type": "number" },
            "bottom": { "type": "number" },
            "left": { "type": "number" }
          }
        },
        "headerTwips": { "type": "number" },
        "footerTwips": { "type": "number" },
        "gutterTwips": { "type": "number" }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "page", "sourcePart", "headerFooterReferences"],
      "properties": {
        "index": { "type": "integer" },
        "page": { "$ref": "#/$defs/page" },
        "sourcePart": { "type": "string" },
        "headerFooterReferences": {
          "type": "array",
          "items": { "$ref": "#/$defs/headerFooterReference" }
        }
      }
    },
    "headerFooterReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "variant", "relationshipId", "partPath"],
      "properties": {
        "kind": { "enum": ["header", "footer"] },
        "variant": { "enum": ["default", "first", "even"] },
        "relationshipId": { "type": "string" },
        "partPath": { "type": ["string", "null"] }
      }
    },
    "headerFooter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sectionIndex",
        "kind",
        "variant",
        "relationshipId",
        "partPath",
        "text",
        "fields"
      ],
      "properties": {
        "sectionIndex": { "type": "integer", "minimum": 0 },
        "kind": { "enum": ["header", "footer"] },
        "variant": { "enum": ["default", "first", "even"] },
        "relationshipId": { "type": "string" },
        "partPath": { "type": ["string", "null"] },
        "text": { "type": "string" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["partPath", "instruction", "kind"],
      "properties": {
        "partPath": { "type": "string" },
        "instruction": { "type": "string" },
        "kind": { "type": "string" }
      }
    },
    "caption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paragraphIndex", "styleId", "text", "sequence"],
      "properties": {
        "paragraphIndex": { "type": "integer", "minimum": 0 },
        "styleId": { "type": ["string", "null"] },
        "text": { "type": "string" },
        "sequence": { "type": ["string", "null"] }
      }
    },
    "numbering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["partPath", "abstractNumbers", "instances"],
      "properties": {
        "partPath": { "type": ["string", "null"] },
        "abstractNumbers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "levels"],
            "properties": {
              "id": { "type": "string" },
              "levels": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "instances": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "abstractNumberId"],
            "properties": {
              "id": { "type": "string" },
              "abstractNumberId": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "fonts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme", "families"],
      "properties": {
        "theme": {
          "type": "object",
          "additionalProperties": false,
          "required": ["major", "minor"],
          "properties": {
            "major": { "type": ["string", "null"] },
            "minor": { "type": ["string", "null"] }
          }
        },
        "families": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["family", "sourcePart"],
            "properties": {
              "family": { "type": "string" },
              "sourcePart": { "type": "string" }
            }
          }
        }
      }
    },
    "unsupportedPart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["partPath", "reason"],
      "properties": {
        "partPath": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "styleId",
        "name",
        "resolved",
        "requestedFontFamily",
        "provenance"
      ],
      "properties": {
        "styleId": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "resolved": { "type": "object" },
        "requestedFontFamily": { "type": "string" },
        "provenance": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
